# entorno
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# datos descargados — se regeneran con los scripts
data/
# el canon no se regenera: es el registro de resultados que el manuscrito cita y que los
# drivers de figuras contrastan, así que viaja con el repositorio
!data/canon_manuscrito.json
cache/
*.tif
*.tiff
*.nc
*.zip

# features extraídos por el backbone congelado
features/
*.npy
*.npz
*.pt

# sistema
.DS_Store

# compilados de LaTeX; el manuscrito se compila desde main.tex
docs/manuscript/*.aux
docs/manuscript/*.log
docs/manuscript/*.out
docs/manuscript/*.pdf
docs/manuscript/*.bbl
docs/manuscript/*.blg
docs/manuscript/*.fls
docs/manuscript/*.fdb_latexmk
docs/manuscript/*.synctex.gz

# paquete del benchmark; se distribuye por Zenodo, nunca por el repo
dist/
