\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The exchange rate between aggregates and maps.} \textbf  {a}, Within-municipality agreement between the weakly supervised map and held-out tract grades, as a function of how many municipal aggregates supervise training (nested, grade-stratified sampling; mean $\pm $ s.d. over three seeds; dashed line: oracle trained on tract labels). \textbf  {b}, The same bags re-labelled with coarser aggregates. \textbf  {c}, Sensor and resolution: block-averaging optical imagery to the radar's resolution barely hurts; radar collapses despite being the best predictor of municipal grades.}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:curve}{{1}{6}{\textbf {The exchange rate between aggregates and maps.} \textbf {a}, Within-municipality agreement between the weakly supervised map and held-out tract grades, as a function of how many municipal aggregates supervise training (nested, grade-stratified sampling; mean $\pm $ s.d. over three seeds; dashed line: oracle trained on tract labels). \textbf {b}, The same bags re-labelled with coarser aggregates. \textbf {c}, Sensor and resolution: block-averaging optical imagery to the radar's resolution barely hurts; radar collapses despite being the best predictor of municipal grades}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Predicting is not localizing.} \textbf  {a}, Map quality by model family on identical features, bags and labels. Attention-based MIL is at chance because the bag task is solvable from the feature mean; predicting instances and averaging predictions (label proportions) makes the map the mechanism. \textbf  {b}, Across the hyperparameter sweep, the only criterion weak supervision may monitor (bag error) is nearly uncorrelated with map quality.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:dissociation}{{2}{6}{\textbf {Predicting is not localizing.} \textbf {a}, Map quality by model family on identical features, bags and labels. Attention-based MIL is at chance because the bag task is solvable from the feature mean; predicting instances and averaging predictions (label proportions) makes the map the mechanism. \textbf {b}, Across the hyperparameter sweep, the only criterion weak supervision may monitor (bag error) is nearly uncorrelated with map quality}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {External validity.} \textbf  {a}, Within-municipality agreement of downloadable products and of this work, under one protocol. \textbf  {b}, Replication against an independent institution's continuous index. \textbf  {c}, Share of the aggregate-to-census targeting gap closed by allocating a fixed budget with the map (people pooled across the 14 held-out cities).}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:validation}{{3}{7}{\textbf {External validity.} \textbf {a}, Within-municipality agreement of downloadable products and of this work, under one protocol. \textbf {b}, Replication against an independent institution's continuous index. \textbf {c}, Share of the aggregate-to-census targeting gap closed by allocating a fixed budget with the map (people pooled across the 14 held-out cities)}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Zero-shot transfer.} The Mexican model, unchanged, ordering Bogotá's block-level strata and detecting Rio's mapped informal settlements. The deprivation gradient travels; informality is a different construct.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:transfer}{{4}{7}{\textbf {Zero-shot transfer.} The Mexican model, unchanged, ordering Bogotá's block-level strata and detecting Rio's mapped informal settlements. The deprivation gradient travels; informality is a different construct}{figure.4}{}}
